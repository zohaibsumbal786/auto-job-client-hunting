# OpenAI API (for generating personalized proposals)
OPENAI_API_KEY=your-openai-api-key

# Optional: LinkedIn API (requires LinkedIn Developer Account)
LINKEDIN_ACCESS_TOKEN=your-linkedin-token

# Optional: Hunter.io API (for finding email addresses)
HUNTER_API_KEY=your-hunter-api-key
